# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — it never gets committed, so real secrets stay local.

# Required everywhere. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Local dev: True. Production: False (or just omit — False is the default).
DEBUG=True

# Comma-separated. Must include your real domain(s) in production,
# e.g. ALLOWED_HOSTS=freightline.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed in production, for the exact https:// origin(s) you serve from.
# e.g. CSRF_TRUSTED_ORIGINS=https://freightline.example.com
CSRF_TRUSTED_ORIGINS=

# Optional — defaults to the local db.sqlite3 file if unset.
# Production: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Optional — raise once HTTPS is confirmed working on your real domain.
# Start with 2592000 (30 days), then 31536000 (1 year). Leave unset/0 until then.
SECURE_HSTS_SECONDS=

# Optional email settings — the app doesn't send email today, so the
# console backend (prints to stdout) is fine until it does.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Freightline <no-reply@freightline.example.com>
